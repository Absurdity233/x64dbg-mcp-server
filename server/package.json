{
  "name": "x64dbg-mcp-server",
  "version": "2.7.0",
  "description": "MCP server for x64dbg debugger - 29 mega-tools for AI-powered reverse engineering and debugging",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "x64dbg-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/lease.test.mjs test/instances.test.mjs test/guards.test.mjs test/debug-state.test.mjs",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "x64dbg",
    "debugger",
    "reverse-engineering",
    "model-context-protocol",
    "claude",
    "ai-debugging"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Absurdity233/x64dbg-mcp-server.git",
    "directory": "server"
  },
  "homepage": "https://github.com/Absurdity233/x64dbg-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/Absurdity233/x64dbg-mcp-server/issues"
  },
  "mcpName": "io.github.Absurdity233/x64dbg",
  "author": "Absurdity233",
  "contributors": [
    {
      "name": "bromo",
      "url": "https://github.com/bromoket",
      "comment": "original author of x64dbg_mcp, the MIT-licensed base of this fork"
    }
  ],
  "upstream": {
    "repo": "https://github.com/bromoket/x64dbg_mcp",
    "author": "bromo",
    "license": "MIT",
    "note": "Fork. The plugin, REST bridge and original 23 tools come from upstream."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
